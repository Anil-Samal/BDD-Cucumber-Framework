<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level [%t] %c - %msg%n"/>
        </Console>

        <RollingFile
                name="File"
                fileName="logs/framework.log"
                filePattern="logs/framework-%d{yyyy-MM-dd}.log">

            <PatternLayout
                pattern="%d %-5level %c - %msg%n"/>

            <Policies>
                <TimeBasedTriggeringPolicy/>
            </Policies>

        </RollingFile>

    </Appenders>

    <Loggers>

        <Root level="info">

            <AppenderRef ref="Console"/>

            <AppenderRef ref="File"/>

        </Root>

    </Loggers>

</Configuration>